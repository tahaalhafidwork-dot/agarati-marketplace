# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local IDE / Cursor agent (may contain MCP tokens)
.cursor/

# MCP configuration (do not commit — may reference auth headers)
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design extractor tooling + raw Playwright dumps
/tools/design-md-extractor/
/docs/references/**/raw/
/docs/references/**/live/*.html
/docs/references/**/live/*.md

# Expo native projects (regenerate via `npx expo prebuild`)
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.android-usb/
apps/mobile/dist/
apps/mobile/.expo/

.vercel
.env*
