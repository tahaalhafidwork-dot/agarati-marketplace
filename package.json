{
  "name": "agarati-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "characterize": "npx --yes tsx tests/characterization/run.ts",
    "test:subscriptions": "npx --yes tsx tests/subscriptions/run.ts",
    "test:agarly": "npx --yes tsx tests/agarly/run.ts",
    "test:subscriptions:db": "npx --yes tsx tests/subscriptions/database.ts",
    "test:subscriptions:services": "node tests/subscriptions/service-runner.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
