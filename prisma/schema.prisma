// AGARATİ — Prisma + PostgreSQL (Supabase)
// See docs/SUPABASE_SETUP.md for provisioning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SEEKER
  LISTER
  ADMIN
}

enum DealType {
  SALE
  RENT
  DAILY
}

enum PropertyCategory {
  APARTMENT
  HOUSE
  VILLA
  OFFICE
  LAND
  BUILDING
  FARM
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
}

enum ContactLeadStatus {
  NEW
  READ
  ARCHIVED
}

enum ContactMethod {
  WHATSAPP_PHONE
  ALL
  CHAT
}

enum PropertyRequestStatus {
  PENDING
  OPEN
  FULFILLED
  CLOSED
  REJECTED
}

enum ReportKind {
  MISLEADING_LISTING
  FRAUD
  ILLEGAL_CONTENT
  IMPERSONATION
  TECHNICAL
  OTHER
}

enum ReportStatus {
  NEW
  REVIEWING
  RESOLVED
  DISMISSED
}

enum AccountType {
  INDIVIDUAL
  AGENCY
}

enum AgencyUpgradeStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum AgencyStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum AgencyMemberRole {
  OWNER
  AGENT
}

enum AgencyMembershipStatus {
  ACTIVE
  LEFT
}

enum AgencyQuotaMode {
  EQUAL
  MANUAL
}

enum AgencyInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentPurpose {
  INDIVIDUAL_LISTING
  AGENCY_SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ListingBillingKind {
  PERSONAL_FREE
  PERSONAL_PAID
  AGENCY_INCLUDED
}

enum ListingBillingState {
  READY
  PAYMENT_REQUIRED
  SUBSCRIPTION_REQUIRED
}

enum AgarlySearchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                     String              @id // matches Supabase auth.users.id (UUID)
  email                  String              @unique
  name                   String
  phone                  String?
  whatsapp               String?
  /// Platform access. SEEKER/LISTER are legacy normal-user values; ADMIN is privileged.
  role                   UserRole            @default(LISTER)
  avatarUrl              String?
  notifyMessages         Boolean             @default(true)
  notifyOther            Boolean             @default(true)
  /// Commercial identity only: an individual account or an agency account.
  accountType            AccountType         @default(INDIVIDUAL)
  agencyUpgradeStatus    AgencyUpgradeStatus @default(NONE)
  agencyOfficeName       String?
  agencyLogoUrl          String?
  agencySocialUrl        String?
  agencyRequestNote      String?             @db.Text
  agencyRequestedAt      DateTime?
  /// Public office location (required for agency signup / upgrade)
  agencyCitySlug         String?
  agencyDistrictSlug     String?
  agencyNeighborhoodSlug String?
  agencyAddressLine      String?
  agencyBio              String?             @db.Text
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  listings                  Listing[]
  favorites                 Favorite[]
  savedSearches             SavedSearch[]
  contactLeads              ContactLead[]            @relation("LeadRecipient")
  sentMessages              Message[]                @relation("SentMessages")
  receivedMessages          Message[]                @relation("ReceivedMessages")
  propertyRequests          PropertyRequest[]
  propertyRequestMessages   PropertyRequestMessage[] @relation("PropertyRequestMessages")
  reports                   Report[]
  agencyProjects            AgencyProject[]
  createdProjects           Project[]                @relation("ProjectCreator")
  projectPhotos             ProjectPhoto[]
  createdAgencies           Agency[]                 @relation("AgencyCreator")
  agencyMemberships         AgencyMembership[]
  sentAgencyInvitations     AgencyInvitation[]       @relation("AgencyInvitationSender")
  receivedAgencyInvitations AgencyInvitation[]       @relation("AgencyInvitationRecipient")
  assignedAgencyListings    Listing[]                @relation("ListingAssignedAgent")
  requestedPayments         PaymentRequest[]         @relation("PaymentRequester")
  approvedPayments          PaymentRequest[]         @relation("PaymentApprover")
  agarlySearches            AgarlySearchUsage[]
}

/// Server-side audit and quota ledger for Agarly AI. The raw search prompt is
/// deliberately never stored; promptHash only supports abuse investigation.
model AgarlySearchUsage {
  id          String             @id @default(cuid())
  requestId   String             @unique
  userId      String
  promptHash  String
  provider    String
  model       String
  status      AgarlySearchStatus @default(PROCESSING)
  filters     Json?
  errorCode   String?
  createdAt   DateTime           @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Listing {
  id          String           @id @default(cuid())
  title       String
  description String           @db.Text
  category    PropertyCategory
  deal        DealType
  status      ListingStatus    @default(DRAFT)

  /// Price in IQD (integer fils-free whole dinars)
  priceIqd       Int
  rooms          String?
  /// Normalized room count used by forms and exact filtering.
  roomCount      Int?
  areaM2         Int?
  floor          String?
  /// Unit position inside a building: 0 = ground, negative = basement.
  floorNumber    Int?
  /// Number of levels occupied by the advertised property (2 = duplex).
  propertyFloors Int?
  /// Total floors in the host building for apartments/offices.
  buildingFloors Int?
  heating        String?
  furnished      String?
  meta           String?

  citySlug            String
  districtSlug        String
  neighborhoodSlug    String
  complexSlug         String?
  /// Name typed when proposing a new complex (admin may rename before approve)
  proposedComplexName String?
  /// Street / mahalla — shown on public listing detail
  streetPrivate       String?
  contactMethod       ContactMethod? @default(CHAT)
  listingNumber       String?        @unique
  /// Approximate public map coordinates (never exact street GPS)
  mapLat              Float?
  mapLng              Float?
  /// Advertiser-selected amenities / nearby services (Arabic labels)
  services            String[]       @default([])
  /// Public detail page views (owner analytics)
  viewCount           Int            @default(0)

  moderationNote       String?
  publishedAt          DateTime?
  /// Public visibility window end (publishedAt + 60 days per paid/free term)
  expiresAt            DateTime?
  /// Owner hid from public browse without freeing quota
  visibilityPaused     Boolean             @default(false)
  /// Billing ownership remains explicit even after an ad expires.
  billingKind          ListingBillingKind  @default(PERSONAL_FREE)
  billingState         ListingBillingState @default(READY)
  /// Set once moderation approves the content; billing may still block publish.
  moderationApprovedAt DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Non-null means the agency owns the listing; ownerId is the stable agency principal.
  agencyId        String?
  agency          Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  /// Current responsible agent; may be cleared/reassigned after departure.
  assignedAgentId String?
  assignedAgent   User?   @relation("ListingAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  images       ListingImage[]
  favorites    Favorite[]
  contactLeads ContactLead[]
  messages     Message[]
  payments     PaymentRequest[]

  @@index([status, createdAt])
  @@index([citySlug, districtSlug])
  @@index([category, deal, status])
  @@index([status, category, roomCount])
  @@index([status, category, floorNumber])
  @@index([status, category, propertyFloors])
  @@index([ownerId])
  @@index([agencyId, status, expiresAt])
  @@index([assignedAgentId, status])
  @@index([ownerId, billingKind, createdAt])
}

/// A legal/operational office. Users join it through AgencyMembership.
model Agency {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  status           AgencyStatus    @default(PENDING)
  quotaMode        AgencyQuotaMode @default(EQUAL)
  logoUrl          String?
  coverUrl         String?
  bio              String?         @db.Text
  phone            String?
  whatsapp         String?
  websiteUrl       String?
  instagramUrl     String?
  facebookUrl      String?
  citySlug         String?
  districtSlug     String?
  neighborhoodSlug String?
  addressLine      String?
  mapLat           Float?
  mapLng           Float?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  createdBy     User                 @relation("AgencyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships   AgencyMembership[]
  invitations   AgencyInvitation[]
  subscriptions AgencySubscription[]
  listings      Listing[]
  payments      PaymentRequest[]

  @@index([status, name])
  @@index([citySlug, districtSlug, neighborhoodSlug])
  @@index([createdById])
}

model AgencyMembership {
  id          String                 @id @default(cuid())
  agencyId    String
  userId      String
  role        AgencyMemberRole
  status      AgencyMembershipStatus @default(ACTIVE)
  manualQuota Int                    @default(0)
  joinedAt    DateTime               @default(now())
  leftAt      DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId, status])
  @@index([agencyId, status, role])
}

model AgencyInvitation {
  id              String                 @id @default(cuid())
  agencyId        String
  emailNormalized String
  invitedUserId   String?
  invitedById     String
  tokenHash       String                 @unique
  status          AgencyInvitationStatus @default(PENDING)
  manualQuota     Int                    @default(0)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  agency      Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitedUser User?  @relation("AgencyInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedBy   User   @relation("AgencyInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([agencyId, status, createdAt])
  @@index([emailNormalized, status])
  @@index([invitedUserId, status])
}

model AgencySubscription {
  id        String             @id @default(cuid())
  agencyId  String
  paymentId String             @unique
  status    SubscriptionStatus @default(ACTIVE)
  priceIqd  Int                @default(40000)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  agency  Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  payment PaymentRequest @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([agencyId, status, endsAt])
}

model PaymentRequest {
  id                String         @id @default(cuid())
  idempotencyKey    String         @unique
  purpose           PaymentPurpose
  status            PaymentStatus  @default(PENDING)
  amountIqd         Int
  listingId         String?
  agencyId          String?
  requestedById     String
  approvedById      String?
  externalReference String?        @unique
  rejectionReason   String?
  approvedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  listing      Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  agency       Agency?             @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  requestedBy  User                @relation("PaymentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("PaymentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  subscription AgencySubscription?

  @@index([status, createdAt])
  @@index([requestedById, status, createdAt])
  @@index([listingId, status])
  @@index([agencyId, status])
}

model ListingImage {
  id          String @id @default(cuid())
  listingId   String
  storagePath String
  sortOrder   Int    @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

/// Saved browse/search list (filters URL) — distinct from single-listing Favorite.
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  title     String
  /// Full path e.g. /properties?type=apartment&deal=rent
  href      String
  /// Normalized query string for uniqueness (without leading ?)
  queryKey  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, queryKey])
  @@index([userId, createdAt])
}

model ContactLead {
  id        String            @id @default(cuid())
  listingId String
  /// Owner of the listing (denormalized for inbox queries)
  ownerId   String
  fromName  String
  fromPhone String
  message   String            @db.Text
  status    ContactLeadStatus @default(NEW)
  createdAt DateTime          @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner   User    @relation("LeadRecipient", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, createdAt])
  @@index([listingId])
}

model Message {
  id        String    @id @default(cuid())
  listingId String
  fromId    String
  toId      String
  content   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  from    User    @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  to      User    @relation("ReceivedMessages", fields: [toId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

/// Seeker «wanted» request — public board for matching listers.
model PropertyRequest {
  id               String                @id @default(cuid())
  userId           String
  title            String
  description      String                @db.Text
  category         PropertyCategory?
  deal             DealType?
  citySlug         String?
  districtSlug     String?
  neighborhoodSlug String?
  rooms            String?
  minBudgetIqd     Int?
  maxBudgetIqd     Int?
  minAreaM2        Int?
  maxAreaM2        Int?
  status           PropertyRequestStatus @default(PENDING)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages PropertyRequestMessage[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([citySlug, category, deal, status])
}

model PropertyRequestMessage {
  id        String    @id @default(cuid())
  requestId String
  fromId    String
  /// Counterpart (request owner or the interested party)
  toId      String
  content   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  request PropertyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  from    User            @relation("PropertyRequestMessages", fields: [fromId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

model Report {
  id             String       @id @default(cuid())
  referenceCode  String       @unique
  kind           ReportKind
  status         ReportStatus @default(NEW)
  description    String       @db.Text
  listingRef     String?
  contactEmail   String?
  contactPhone   String?
  reporterUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter User? @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// Marketing / development project (e.g. residential complex) agencies can claim.
enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

/// Public `/projects` lists RESIDENTIAL + MIXED_USE only; COMMERCIAL = malls etc.
enum ProjectKind {
  RESIDENTIAL
  MIXED_USE
  COMMERCIAL
}

model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  status           ProjectStatus @default(PENDING)
  projectKind      ProjectKind   @default(RESIDENTIAL)
  /// Cover image (Supabase or curated URL)
  imageUrl         String?
  /// Additional development photos (1-3). Curated or Supabase URLs.
  imageUrls        String[]      @default([])
  /// Short public blurb about the development
  summary          String?       @db.Text
  websiteUrl       String?
  citySlug         String?
  districtSlug     String?
  neighborhoodSlug String?
  createdById      String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  createdBy User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  agencies  AgencyProject[]
  photos    ProjectPhoto[]

  @@index([name])
  @@index([status, createdAt])
  @@index([citySlug])
  @@index([projectKind, status])
}

/// Community / contributor photo for a project gallery (admin-moderated).
model ProjectPhoto {
  id              String        @id @default(cuid())
  projectId       String
  storagePath     String
  status          ProjectStatus @default(PENDING)
  contributorId   String?
  /// Snapshot of display name at contribution time
  contributorName String
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contributor User?   @relation(fields: [contributorId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([status, createdAt])
}

/// Agency authorized to market a project (sales desk).
model AgencyProject {
  userId              String
  projectId           String
  createdAt           DateTime @default(now())
  /// Reserved: official sales center after admin verification (not self-serve yet).
  isOfficialSalesDesk Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}
